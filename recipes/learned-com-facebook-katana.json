{
  "recipe": "glint.recipe/1",
  "id": "learned-com-facebook-katana",
  "rev": 1,
  "name": "facebook",
  "app": {
    "package": "com.facebook.katana",
    "label": "Facebook"
  },
  "meta": {
    "status": "learned",
    "author": "Glint",
    "notes": "Learned from 10 notification shapes over 5 days. Reviewed: counts only, off by default (the spec's plan for Facebook); the digest's title is the account's own name, so it isn't drawn.",
    "updated": "2026-11-14"
  },
  "source": {
    "notification": {
      "match": {
        "channels": [
          "99%#$reminders%#$555-0100%#$9"
        ],
        "notCategories": [
          "alarm",
          "call",
          "msg",
          "promo",
          "recommendation",
          "sys",
          "transport"
        ],
        "anchors": [
          "(?i)\\b(?:messages)\\b"
        ],
        "lang": [
          "en"
        ]
      }
    }
  },
  "faces": [
    {
      "kind": "count",
      "count": "{news}",
      "label": "new",
      "peek": "{posted|ago}"
    },
    {
      "kind": "count",
      "count": "{msgs}",
      "label": "messages",
      "peek": "{posted|ago}",
      "when": [
        "!news"
      ]
    }
  ],
  "enabled": false,
  "fields": {
    "news": {
      "from": [
        "text"
      ],
      "regex": "(?i)\\b(?P<v>\\d{1,4}) new notifications?\\b",
      "lang": [
        "en"
      ]
    },
    "msgs": {
      "from": [
        "text"
      ],
      "regex": "(?i)\\b(?P<v>\\d{1,4}) messages?\\b",
      "lang": [
        "en"
      ]
    }
  }
}

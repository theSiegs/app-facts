{
  "recipe": "glint.recipe/1",
  "id": "learned-com-google-android-googlequicksearchbox",
  "rev": 1,
  "name": "google",
  "app": {
    "package": "com.google.android.googlequicksearchbox",
    "label": "Google"
  },
  "meta": {
    "status": "learned",
    "author": "Glint",
    "notes": "Learned from 30 notification shapes over 2 days. Reviewed: the weather without its \"see full forecast\" link words; fades after 3 h, gone after 12 h; no count flip.",
    "updated": "2026-11-15"
  },
  "source": {
    "notification": {
      "match": {
        "channels": [
          "99"
        ],
        "notCategories": [
          "alarm",
          "call",
          "msg",
          "promo",
          "recommendation",
          "sys",
          "transport"
        ],
        "anchors": [
          "(?i)\\b(?:full|see)\\b"
        ],
        "lang": [
          "en"
        ]
      },
      "fade": "3h",
      "expire": "12h"
    }
  },
  "faces": [
    {
      "title": "{title}",
      "line": "{sky}",
      "peek": "{posted|ago}"
    },
    {
      "title": "{title}",
      "peek": "{posted|ago}"
    }
  ],
  "fields": {
    "sky": {
      "from": [
        "text"
      ],
      "regex": "(?i)^(?P<v>.+?)\\s*·\\s*see full\\b",
      "lang": [
        "en"
      ],
      "then": [
        "collapse"
      ]
    }
  }
}

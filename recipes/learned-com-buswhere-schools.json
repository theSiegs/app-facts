{
  "recipe": "glint.recipe/1",
  "id": "learned-com-buswhere-schools",
  "rev": 1,
  "name": "buswhere",
  "app": {
    "package": "com.buswhere.schools",
    "label": "BusWhere"
  },
  "meta": {
    "status": "learned",
    "author": "Glint",
    "notes": "Learned from 7 notification shapes over 4 days. Reviewed: the stop it is headed to as the line; fades after 30 min, gone after 3 h.",
    "updated": "2026-11-13"
  },
  "source": {
    "notification": {
      "match": {
        "channels": [
          "xxx_xxxxxxxx_notification_channel"
        ],
        "notCategories": [
          "alarm",
          "call",
          "msg",
          "promo",
          "recommendation",
          "sys",
          "transport"
        ],
        "anchors": [
          "(?i)\\b(?:bus|map|real)\\b"
        ],
        "lang": [
          "en"
        ]
      },
      "fade": "30m",
      "expire": "3h"
    }
  },
  "faces": [
    {
      "title": "{title}",
      "line": "to {to}",
      "peek": "{posted|ago}"
    },
    {
      "title": "{title}",
      "line": "{text}",
      "peek": "{time}"
    },
    {
      "title": "{title}",
      "peek": "{time}",
      "when": [
        "!text"
      ]
    },
    {
      "kind": "count",
      "count": "{count}",
      "label": "new",
      "when": [
        "count>1"
      ],
      "flip": true
    }
  ],
  "fields": {
    "to": {
      "from": [
        "text",
        "bigText"
      ],
      "regex": "(?i)\\bon its way to (?P<v>[^.]{1,60}?)\\s*\\.",
      "lang": [
        "en"
      ],
      "then": [
        "collapse",
        "shorten:32"
      ]
    }
  }
}

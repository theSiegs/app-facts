{
  "recipe": "glint.recipe/1",
  "id": "learned-com-google-android-calendar",
  "rev": 1,
  "name": "calendar",
  "app": {
    "package": "com.google.android.calendar",
    "label": "Calendar"
  },
  "meta": {
    "status": "learned",
    "author": "Glint",
    "notes": "Learned from 7 notification shapes over 5 days. Reviewed: the event and its time, with how soon it starts as the peek; no count flip.",
    "updated": "2026-11-14"
  },
  "source": {
    "notification": {
      "match": {
        "channels": [
          "REMINDERS"
        ],
        "notCategories": [
          "alarm",
          "call",
          "msg",
          "promo",
          "recommendation",
          "sys",
          "transport"
        ]
      }
    }
  },
  "faces": [
    {
      "title": "{title}",
      "line": "{text}",
      "peek": "{when|near}"
    },
    {
      "title": "{title}",
      "line": "{when|near}",
      "when": [
        "!text"
      ]
    }
  ]
}

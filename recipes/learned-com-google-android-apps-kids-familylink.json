{
  "recipe": "glint.recipe/1",
  "id": "learned-com-google-android-apps-kids-familylink",
  "rev": 1,
  "name": "family link",
  "app": {
    "package": "com.google.android.apps.kids.familylink",
    "label": "Family Link"
  },
  "meta": {
    "status": "learned",
    "author": "Glint",
    "notes": "Learned from 18 notification shapes over 3 days.",
    "updated": "2026-11-15"
  },
  "source": {
    "notification": {
      "match": {
        "channels": [
          "NEW_APPS_CHANNEL_XX",
          "OTHER_CHANNEL_XX"
        ],
        "notCategories": [
          "alarm",
          "call",
          "msg",
          "promo",
          "recommendation",
          "sys",
          "transport"
        ],
        "anchors": [
          "(?i)\\b(?:app|installed|new)\\b"
        ],
        "lang": [
          "en"
        ]
      }
    }
  },
  "faces": [
    {
      "title": "{title}",
      "line": "{text}",
      "peek": "{time}"
    },
    {
      "title": "{title}",
      "peek": "{time}",
      "when": [
        "!text"
      ]
    },
    {
      "kind": "count",
      "count": "{count}",
      "label": "new",
      "when": [
        "count>1"
      ],
      "flip": true
    }
  ]
}
